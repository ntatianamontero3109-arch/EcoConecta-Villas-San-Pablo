# Copia este archivo como .env y reemplaza TODOS los valores de ejemplo.
APP_NAME=EcoConecta
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
POSTGRES_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_POSTGRES_SEGURA
DATABASE_URL=postgresql+psycopg://ecoconecta:REEMPLAZAR_POR_UNA_CLAVE_POSTGRES_SEGURA@db:5432/ecoconecta
ACCESS_TOKEN_MINUTES=720
POINTS_PER_KG=1
ENVIRONMENT=development
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_CO

# Consentimiento explícito: números autorizados separados por coma. Vacío = no enviar.
WHATSAPP_ALLOWED_RECIPIENTS=
